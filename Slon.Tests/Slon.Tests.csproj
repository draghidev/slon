<Project Sdk="MSTest.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <Features Condition="'$(TargetFramework)' == 'net11.0'">runtime-async=on</Features>
        <LangVersion>preview</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <NoWarn>$(NoWarn);SLONPG001;SLONPOOL001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
        <ProjectReference Include="../Slon/Slon.csproj" />
    </ItemGroup>

    <ItemGroup>
        <TestingPlatformBuilderHook Include="61BA53CE-BF62-4E39-927A-A491E78473F1">
            <DisplayName>Slon last-chance test ledger</DisplayName>
            <TypeFullName>Slon.Tests.LastChanceTestLedgerHook</TypeFullName>
        </TestingPlatformBuilderHook>
    </ItemGroup>
</Project>
